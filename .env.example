WORKBENCH_DATA_DIR='./data'

# 可选。通过私有文件配置订阅下载入口和管理账号。
# WORKBENCH_DISTRIBUTION_CONFIG='./data/private/distribution.json'
# WORKBENCH_ADMIN_CONFIG='./data/private/tailnet-admin.json'

# 可选。节点测速。
# WORKBENCH_MIHOMO='/path/to/mihomo'
# WORKBENCH_FLCLASH_CORE='/path/to/FlClashCore'
# WORKBENCH_PROBE_INTERFACE='eth0'
# WORKBENCH_ABUSEIPDB_KEY='在本地填写'

# 可选。MoVPN 和旧版配置引用所需的本机文件。
# WORKBENCH_MOVPN_DB='./data/private/movpn.db'
# WORKBENCH_DESKTOP_CONFIG='./data/private/desktop.yaml'
# WORKBENCH_PHONE_CONFIG='./data/private/phone.yaml'
# WORKBENCH_KITTY_CONFIG='./data/private/provider.yaml'

# 可选。Node.js 预览读取独立的真实配置快照。
# WORKBENCH_REQUIRE_LIVE='1'
# WORKBENCH_STORE_PATH='./data/private/live-store.json'
